# Copy this file to .env.performance.local and fill in the dedicated performance environment.
# The database name and confirmation must both be exactly cc4c_perf_test.
CC4C_PERF_DB_URL=jdbc:mysql://127.0.0.1:3306/cc4c_perf_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
CC4C_PERF_DB_USERNAME=cc4c_test_user
CC4C_PERF_DB_PASSWORD=
CC4C_PERF_DB_RESET_CONFIRM=cc4c_perf_test
CC4C_PERF_CACHE_REDIS_URL=redis://127.0.0.1:6379/14
