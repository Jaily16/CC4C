root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{js,mjs,vue,css,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
