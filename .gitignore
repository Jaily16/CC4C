# Local application environments: only sanitized examples may be committed.
**/.env
**/.env.*
!**/.env.example
*.local

# Build output, dependencies, scratch data, logs, and uploaded resources.
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
/backend/target/
/backend/logs/
/temp/
/logs/
*.log
/frontend/public/avatar/
/frontend/public/blogImg/

# Only the controlled backend application.yml is a tracked framework resource.
/backend/src/main/resources/application*.yml
/backend/src/main/resources/application*.yaml
/backend/src/main/resources/application*.properties
!/backend/src/main/resources/application.yml

# Protect ignored legacy data without retaining runtime fallback paths.
/back-end/CC4C/target/
/back-end/CC4C/logs/
/back-end/CC4C/src/main/resources/application.yml
/front-end/CC4C/public/avatar/
/front-end/CC4C/public/blogImg/
/deploy/secrets/local/
/deploy/secrets/runtime/
/infrastructure/secrets/local/
/infrastructure/secrets/runtime/

# Editor and operating-system files; keep the existing frontend extension list.
/.vscode/
/frontend/.vscode/*
!/frontend/.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
