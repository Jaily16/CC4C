# Copy this file to .env.test.local and fill in the dedicated test database credentials.
# Do not quote values. The local file is ignored by Git.
CC4C_TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/cc4c_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
CC4C_TEST_EMPTY_DB_URL=jdbc:mysql://127.0.0.1:3306/cc4c_flyway_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
CC4C_TEST_DB_USERNAME=cc4c_test_user
CC4C_TEST_DB_PASSWORD=
CC4C_TEST_REDIS_URL=redis://127.0.0.1:6379/15
CC4C_TEST_CACHE_REDIS_URL=redis://127.0.0.1:6379/15
CC4C_TEST_RABBITMQ_URL=amqp://cc4c_test_user:replace-me@127.0.0.1:5672/cc4c_test
CC4C_TEST_RABBITMQ_VHOST_CONFIRM=cc4c_test
