{
  "uid": "cc4c-messaging", "title": "CC4C Messaging", "schemaVersion": 41,
  "time": {"from": "now-1h", "to": "now"}, "refresh": "15s", "tags": ["cc4c"],
  "templating": {"list": []},
  "panels": [
    {"id":1,"type":"timeseries","title":"Outbox and Inbox status","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"cc4c_messaging_outbox_messages","legendFormat":"outbox {{status}}"},{"expr":"cc4c_messaging_inbox_messages","legendFormat":"inbox {{status}}"}]},
    {"id":2,"type":"timeseries","title":"Oldest pending and sampler age","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"cc4c_messaging_outbox_oldest_pending_seconds","legendFormat":"oldest pending"},{"expr":"cc4c_messaging_sampler_age_seconds","legendFormat":"sampler age"}]},
    {"id":3,"type":"timeseries","title":"Publish and consume p95","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,event_type) (rate(cc4c_messaging_publish_duration_seconds_bucket[5m])))","legendFormat":"publish {{event_type}}"},{"expr":"histogram_quantile(0.95, sum by (le,event_type) (rate(cc4c_messaging_consume_duration_seconds_bucket[5m])))","legendFormat":"consume {{event_type}}"}]},
    {"id":4,"type":"timeseries","title":"Rabbit queues","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"sum by (queue) (rabbitmq_queue_messages_ready)","legendFormat":"ready {{queue}}"},{"expr":"sum by (queue) (rabbitmq_queue_messages_unacked)","legendFormat":"unacked {{queue}}"},{"expr":"sum by (queue) (rabbitmq_queue_consumers)","legendFormat":"consumers {{queue}}"}]},
    {"id":5,"type":"timeseries","title":"Retries, dead, duplicate and expired","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"sum by (event_type,stage) (rate(cc4c_messaging_retries_total[5m]))","legendFormat":"retry {{event_type}} {{stage}}"},{"expr":"sum by (event_type,error_code) (rate(cc4c_messaging_dead_total[5m]))","legendFormat":"dead {{event_type}} {{error_code}}"},{"expr":"sum by (event_type) (rate(cc4c_messaging_duplicates_total[5m]))","legendFormat":"duplicate {{event_type}}"},{"expr":"sum by (event_type) (rate(cc4c_messaging_expired_total[5m]))","legendFormat":"expired {{event_type}}"}]},
    {"id":6,"type":"timeseries","title":"Publish and consume outcomes","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"sum by (event_type,outcome) (rate(cc4c_messaging_publish_duration_seconds_count[5m]))","legendFormat":"publish {{event_type}} {{outcome}}"},{"expr":"sum by (event_type,outcome) (rate(cc4c_messaging_consume_duration_seconds_count[5m]))","legendFormat":"consume {{event_type}} {{outcome}}"}]},
    {"id":7,"type":"timeseries","title":"Rabbit dead-letter queues","gridPos":{"x":0,"y":24,"w":24,"h":8},"datasource":{"uid":"cc4c-prometheus"},"targets":[{"expr":"sum by (queue) (rabbitmq_queue_messages{queue=~\".*dead.*\"})","legendFormat":"DLQ {{queue}}"}]}
  ]
}
